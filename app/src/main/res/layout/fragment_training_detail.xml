<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="110dp">
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- Page heading -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBackTraining"
                android:layout_width="54dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:text="←"
                android:textColor="#777777"
                android:textSize="37sp" />

            <TextView
                android:id="@+id/txtTrainingTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Basketball Trainings"
                android:textColor="#111111"
                android:textSize="27sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Register button -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegisterNow"
            android:layout_width="230dp"
            android:layout_height="58dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/register_button_bg"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="Register Now    ↗"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <!-- Beginner card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="13dp"
            android:background="@drawable/training_detail_card_bg"
            android:gravity="center_vertical"
            android:minHeight="155dp"
            android:orientation="horizontal"
            android:padding="12dp">

            <View
                android:layout_width="126dp"
                android:layout_height="126dp"
                android:background="@drawable/detail_blue_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:minHeight="126dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtBeginnerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Beginner / Upper Beginner:"
                    android:textColor="#111111"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="1dp"
                    android:text="Designed for beginner and upper beginner players aged 6 to 12 years to learn the fundamentals of basketball in a structured environment."
                    android:textColor="#666666"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="end"
                    android:text="↗"
                    android:textColor="#777777"
                    android:textSize="27sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Intermediate card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="13dp"
            android:background="@drawable/training_detail_card_bg"
            android:gravity="center_vertical"
            android:minHeight="155dp"
            android:orientation="horizontal"
            android:padding="12dp">

            <View
                android:layout_width="126dp"
                android:layout_height="126dp"
                android:background="@drawable/detail_pink_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:minHeight="126dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtIntermediateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Intermediate Basketball:"
                    android:textColor="#111111"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="1dp"
                    android:text="For players who already know the basics and want to improve confidence, teamwork, skills and match-play performance."
                    android:textColor="#666666"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="end"
                    android:text="↗"
                    android:textColor="#777777"
                    android:textSize="27sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Senior card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/training_detail_card_bg"
            android:gravity="center_vertical"
            android:minHeight="155dp"
            android:orientation="horizontal"
            android:padding="12dp">

            <View
                android:layout_width="126dp"
                android:layout_height="126dp"
                android:background="@drawable/detail_orange_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:minHeight="126dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtSeniorTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Senior Basketball:"
                    android:textColor="#111111"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="1dp"
                    android:text="An instructional programme for players with stronger core skills who want a more competitive and structured basketball training environment."
                    android:textColor="#666666"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="end"
                    android:text="↗"
                    android:textColor="#777777"
                    android:textSize="27sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>