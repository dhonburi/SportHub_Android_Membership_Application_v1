<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="135dp">

        <!-- Profile information moved lower from the header -->

        <include
            layout="@layout/layout_profile_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Keeps the gap between profile details and balance section -->

        <include
            layout="@layout/layout_balance_card"
            android:layout_width="match_parent"
            android:layout_height="245dp"
            android:layout_marginTop="20dp" />

        <!-- Rewards section -->

        <include
            layout="@layout/layout_rewards_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <!-- Transactions / Rewards / Memberships -->

        <include
            layout="@layout/layout_shortcuts"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>