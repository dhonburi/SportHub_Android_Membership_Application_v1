<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="228dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Black balance card -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/balanceCard"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/profile_dark_card_bg"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <ImageView
            android:id="@+id/imgBalanceIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Balance"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_balance_card" />

        <TextView
            android:id="@+id/txtBalanceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Balance"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/imgBalanceIcon"
            app:layout_constraintStart_toEndOf="@id/imgBalanceIcon"
            app:layout_constraintTop_toTopOf="@id/imgBalanceIcon" />

        <LinearLayout
            android:id="@+id/layoutBalanceAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txtBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14.67"
                android:textColor="#FFFFFF"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCurrency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_marginBottom="6dp"
                android:text="NZD"
                android:textColor="#858585"
                android:textSize="15sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Gold Top Up button -->

    <LinearLayout
        android:id="@+id/btnTopUpBalance"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="150dp"
        android:layout_marginEnd="44dp"
        android:background="@drawable/profile_gold_button_ripple"
        android:clickable="true"
        android:clipToOutline="true"
        android:elevation="8dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:outlineProvider="background"
        android:paddingStart="22dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Top Up Balance"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:contentDescription="Top up balance"
            app:srcCompat="@drawable/ic_arrow_up_right_white" />

    </LinearLayout>

</FrameLayout>