<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/registrationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/synergyappbackground"
    tools:context=".RegisterActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="SYNERGY&#10;SPORTS"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:background="@drawable/login_card_background"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="64dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="Create Account"
                        android:textColor="#111111"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Create your SportHub member account."
                        android:textColor="#555555"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="* Required fields"
                        android:textColor="#555555"
                        android:textSize="12sp" />

                    <TextView
                        style="@style/RegistrationLabel"
                        android:labelFor="@id/inputFirstName"
                        android:text="First name *" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/fieldFirstName"
                        style="@style/RegistrationField">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputFirstName"
                            style="@style/RegistrationInput"
                            android:autofillHints="personGivenName"
                            android:hint="Enter first name"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLength="50" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/RegistrationLabel"
                        android:labelFor="@id/inputLastName"
                        android:text="Last name *" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/fieldLastName"
                        style="@style/RegistrationField">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputLastName"
                            style="@style/RegistrationInput"
                            android:autofillHints="personFamilyName"
                            android:hint="Enter last name"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLength="50" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/RegistrationLabel"
                        android:labelFor="@id/inputEmail"
                        android:text="Email address *" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/fieldEmail"
                        style="@style/RegistrationField">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputEmail"
                            style="@style/RegistrationInput"
                            android:autofillHints="emailAddress"
                            android:hint="name@example.com"
                            android:inputType="textEmailAddress"
                            android:maxLength="256" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/RegistrationLabel"
                        android:labelFor="@id/inputPassword"
                        android:text="Password *" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/fieldPassword"
                        style="@style/RegistrationField"
                        app:endIconMode="password_toggle"
                        app:helperText="Use 15–128 characters. Spaces and passphrases are welcome.">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputPassword"
                            style="@style/RegistrationInput"
                            android:autofillHints="newPassword"
                            android:hint="Enter password"
                            android:inputType="textPassword"
                            android:saveEnabled="false" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/RegistrationLabel"
                        android:labelFor="@id/inputConfirmPassword"
                        android:text="Confirm password *" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/fieldConfirmPassword"
                        style="@style/RegistrationField"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputConfirmPassword"
                            style="@style/RegistrationInput"
                            android:autofillHints="newPassword"
                            android:hint="Re-enter password"
                            android:inputType="textPassword"
                            android:saveEnabled="false" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/RegistrationLabel"
                        android:layout_marginTop="28dp"
                        android:text="Optional personal details"
                        android:textSize="18sp" />

                    <TextView
                        style="@style/RegistrationLabel"
                        android:labelFor="@id/inputPhone"
                        android:text="Phone number (optional)" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/fieldPhone"
                        style="@style/RegistrationField"
                        app:helperText="9–11 digits, without spaces or a + prefix.">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputPhone"
                            style="@style/RegistrationInput"
                            android:autofillHints="phone"
                            android:hint="Enter phone number"
                            android:inputType="phone" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/RegistrationLabel"
                        android:labelFor="@id/inputGender"
                        android:text="Gender (optional)" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/fieldGender"
                        style="@style/RegistrationField">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/inputGender"
                            style="@style/RegistrationInput"
                            android:hint="Select an option"
                            android:inputType="none"
                            android:importantForAutofill="no"
                            android:text="Not provided" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/RegistrationLabel"
                        android:labelFor="@id/inputDateOfBirth"
                        android:text="Date of birth (optional)" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/fieldDateOfBirth"
                        style="@style/RegistrationField"
                        app:helperText="Tap to select a date. Use Clear to leave it blank.">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputDateOfBirth"
                            style="@style/RegistrationInput"
                            android:hint="DD/MM/YYYY"
                            android:importantForAutofill="no"
                            android:inputType="none"
                            android:imeOptions="actionDone" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/registrationError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="#B3261E"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/registrationProgress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:indeterminateTint="#B18A1C"
                        android:visibility="gone" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnRegister"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/login_button_background"
                        android:minHeight="56dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="Create Account"
                        android:textAllCaps="false"
                        android:textColor="#111111"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                </LinearLayout>

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center_horizontal"
                    android:contentDescription="Synergy Sports logo"
                    android:padding="1dp"
                    android:scaleType="fitCenter"
                    app:shapeAppearanceOverlay="@style/RoundedLogo"
                    app:srcCompat="@drawable/synergy_logo_black"
                    app:strokeColor="@android:color/white"
                    app:strokeWidth="2dp" />

            </FrameLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBackToSignIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/login_secondary_button_background"
                android:minHeight="56dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Already have an account? Sign in"
                android:textAllCaps="false"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>