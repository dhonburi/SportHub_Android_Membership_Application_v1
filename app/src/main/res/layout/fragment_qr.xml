<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/synergyappbackground">

    <FrameLayout
        android:id="@+id/frameMembership"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="90dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Membership Card -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="48dp"
            app:cardElevation="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="70dp"
                android:paddingBottom="40dp">

                <TextView
                    android:id="@+id/textViewTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Membership QR"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:textColor="#D8AE43"/>

                <ImageView
                    android:id="@+id/imageViewQrCode"
                    android:layout_width="310dp"
                    android:layout_height="310dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/qr_image_background"
                    android:padding="5dp"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:id="@+id/textViewReferenceCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="REF: ----"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#111111"/>

                <TextView
                    android:id="@+id/textViewTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Updating in 60s..."
                    android:textSize="15sp"
                    android:textColor="#777777"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Floating Logo -->

        <androidx.cardview.widget.CardView
            android:id="@+id/logoCard"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="top|center_horizontal"
            android:translationY="0dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="45dp"
            app:cardElevation="24dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="3dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="#000000"
                    app:cardCornerRadius="42dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/imgQrLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:cropToPadding="true"
                        android:src="@drawable/synergy_logo_black"/>
                </androidx.cardview.widget.CardView>

            </FrameLayout>

        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <!-- Spacer to prevent bottom clipping -->
    <View
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:alpha="0"
        app:layout_constraintTop_toBottomOf="@id/frameMembership"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>