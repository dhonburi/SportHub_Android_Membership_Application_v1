<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="8dp"
        android:paddingEnd="22dp"
        android:paddingBottom="135dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="68dp">

            <ImageButton
                android:id="@+id/btnMembershipBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back to Profile"
                android:padding="11dp"
                android:src="@drawable/ic_membership_back"
                android:tint="#686868" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Membership"
                android:textColor="#090909"
                android:textSize="31sp"
                android:textStyle="bold" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:text="Your Memberships"
            android:textColor="#111111"
            android:textSize="21sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressMembershipsLoading"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:indeterminateTint="#F2C94C" />

        <TextView
            android:id="@+id/txtMembershipsMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Loading your memberships..."
            android:textColor="#555555"
            android:textSize="15sp" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerMemberships"
            android:layout_width="match_parent"
            android:layout_height="450dp"
            android:layout_marginTop="13dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutMembershipDots"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRetryMemberships"
            android:layout_width="150dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/membership_retry_button_bg"
            android:backgroundTint="@null"
            android:text="Retry memberships"
            android:textAllCaps="false"
            android:textColor="#111111"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="25dp"
            android:text="Available Memberships"
            android:textColor="#111111"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressMembershipPlansLoading"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:indeterminateTint="#F2C94C" />

        <TextView
            android:id="@+id/txtMembershipPlansMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Loading available memberships..."
            android:textColor="#666666"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/layoutMembershipPlans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRetryMembershipPlans"
            android:layout_width="150dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/membership_retry_button_bg"
            android:backgroundTint="@null"
            android:text="Retry plans"
            android:textAllCaps="false"
            android:textColor="#111111"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>