<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/synergyappbackground"
    tools:context=".LoginActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="42dp"
            android:paddingEnd="24dp"
            android:paddingBottom="30dp">

            <!-- Brand title -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:lineSpacingExtra="-3dp"
                android:text="SYNERGY&#10;SPORTS"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <!-- Login card and overlapping logo -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/loginCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="55dp"
                    android:background="@drawable/login_card_background"
                    android:orientation="vertical"
                    android:paddingStart="28dp"
                    android:paddingTop="72dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="28dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="Welcome to&#10;Synergy Sports"
                        android:textColor="#111111"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <!-- Email address -->

                    <TextView
                        android:id="@+id/loginEmailLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="34dp"
                        android:fontFamily="sans-serif"
                        android:labelFor="@id/editTextEmailAddress"
                        android:text="Email address *"
                        android:textColor="#111111"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/loginEmailField"
                        style="@style/RegistrationField">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextEmailAddress"
                            style="@style/RegistrationInput"
                            android:autofillHints="emailAddress"
                            android:hint="name@example.com"
                            android:inputType="textEmailAddress"
                            android:textSize="18sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif"
                        android:labelFor="@id/editTextPassword"
                        android:text="Password *"
                        android:textColor="#111111"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/loginPasswordField"
                        style="@style/RegistrationField"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextPassword"
                            style="@style/RegistrationInput"
                            android:autofillHints="password"
                            android:hint="Enter password"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:saveEnabled="false"
                            android:textSize="18sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- General error or registration confirmation -->

                    <TextView
                        android:id="@+id/alertText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:accessibilityLiveRegion="polite"
                        android:fontFamily="sans-serif"
                        android:gravity="start"
                        android:textColor="#B3261E"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <!-- Login button -->

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/login_button_background"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:onClick="CheckLogin"
                        android:text="Login"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                </LinearLayout>

                <!-- Circular logo overlapping card -->

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/SynergyLogo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center_horizontal"
                    android:padding="1dp"
                    app:shapeAppearanceOverlay="@style/RoundedLogo"
                    app:srcCompat="@drawable/synergy_logo_black"
                    app:strokeColor="@android:color/white"
                    app:strokeWidth="2dp" />

            </FrameLayout>

            <!-- Secondary actions -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="2">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnForgotPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/login_secondary_button_background"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="Forgot Password  ↗"
                    android:textAllCaps="false"
                    android:textColor="#111111"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCreateAccount"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/login_secondary_button_background"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="Create Account  ↗"
                    android:textAllCaps="false"
                    android:textColor="#111111"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>