<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="RegistrationLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">#111111</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RegistrationField" parent="Widget.Design.TextInputLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundMode">none</item>
        <item name="errorTextColor">#B3261E</item>
        <item name="helperTextTextColor">#555555</item>
        <item name="endIconTint">#555555</item>
    </style>

    <style name="RegistrationInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:backgroundTint">#555555</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#111111</item>
        <item name="android:textColorHint">#666666</item>
        <item name="android:textSize">16sp</item>
        <item name="android:imeOptions">actionNext</item>
    </style>

</resources>